# Unified Environment Configuration for QNA Generator
# Copy this file to .env and update with your actual values

# Active Database Type Selection
# Options: sqlserver, mssql, mysql
DB_TYPE=mysql

# MySQL Database Configuration
MYSQL_DB_SERVER=localhost
MYSQL_DB_DATABASE=testdb
MYSQL_DB_USERNAME=testuser
MYSQL_DB_PASSWORD=testpass
MYSQL_DB_DRIVER=mysql+pymysql
MYSQL_DB_PORT=3306

# SQL Server Database Configuration  
SQLSERVER_DB_SERVER=your-sqlserver-host
SQLSERVER_DB_DATABASE=YourSQLDatabase
SQLSERVER_DB_USERNAME=your-sqlserver-username
SQLSERVER_DB_PASSWORD=your-sqlserver-password
SQLSERVER_DB_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_DB_PORT=1433

# Database Connection Settings (Applied to both)
DB_CONNECTION_TIMEOUT=60
DB_COMMAND_TIMEOUT=120
DB_LOGIN_TIMEOUT=60
DB_RETRY_COUNT=3
DB_RETRY_INTERVAL=10

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Generation Settings
SAMPLE_SIZE=10
MIN_QUESTIONS=25
TARGET_JOIN_PERCENTAGE=40
MAX_TABLES=12
DIFFICULTY_LEVEL=mixed
OUTPUT_FILE=qna_dataset.json

# Logging
LOG_LEVEL=INFO

# Notes:
# - Set DB_TYPE to choose which database credentials to use
# - All database-specific credentials are prefixed (MYSQL_ or SQLSERVER_)
# - Connection settings apply to whichever database type is active
# - For Docker MySQL development, use the MYSQL_ settings with localhost
# - For production, update the appropriate database credentials
